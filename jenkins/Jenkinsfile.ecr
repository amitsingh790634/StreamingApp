pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  environment {
    AWS_REGION = 'ap-south-1'
    IMAGE_TAG = "${env.BUILD_NUMBER}"
    RELEASE_TAG = '1.0.0'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Login to ECR') {
      steps {
        withCredentials([
          string(credentialsId: 'aws-account-id', variable: 'AWS_ACCOUNT_ID'),
          [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-ecr']
        ]) {
          sh '''
            ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
            aws ecr get-login-password --region "$AWS_REGION" | docker login --username AWS --password-stdin "$ECR_REGISTRY"
          '''
        }
      }
    }

    stage('Build and push') {
      steps {
        withCredentials([
          string(credentialsId: 'aws-account-id', variable: 'AWS_ACCOUNT_ID'),
          [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-ecr']
        ]) {
          sh '''
            set -eu
            ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

            docker build -t "$ECR_REGISTRY/streaming-auth:$RELEASE_TAG" -t "$ECR_REGISTRY/streaming-auth:$IMAGE_TAG" backend/authService
            docker build -t "$ECR_REGISTRY/streaming-stream:$RELEASE_TAG" -t "$ECR_REGISTRY/streaming-stream:$IMAGE_TAG" -f backend/streamingService/Dockerfile backend
            docker build -t "$ECR_REGISTRY/streaming-admin:$RELEASE_TAG" -t "$ECR_REGISTRY/streaming-admin:$IMAGE_TAG" -f backend/adminService/Dockerfile backend
            docker build -t "$ECR_REGISTRY/streaming-chat:$RELEASE_TAG" -t "$ECR_REGISTRY/streaming-chat:$IMAGE_TAG" -f backend/chatService/Dockerfile backend
            docker build \
              --build-arg REACT_APP_AUTH_API_URL=http://streamingapp.local/api \
              --build-arg REACT_APP_STREAMING_API_URL=http://streamingapp.local/api \
              --build-arg REACT_APP_STREAMING_PUBLIC_URL=http://streamingapp.local \
              --build-arg REACT_APP_ADMIN_API_URL=http://streamingapp.local/api/admin \
              --build-arg REACT_APP_CHAT_API_URL=http://streamingapp.local/api/chat \
              --build-arg REACT_APP_CHAT_SOCKET_URL=http://streamingapp.local \
              -t "$ECR_REGISTRY/streaming-frontend:$RELEASE_TAG" \
              -t "$ECR_REGISTRY/streaming-frontend:$IMAGE_TAG" \
              frontend

            for repo in streaming-auth streaming-stream streaming-admin streaming-chat streaming-frontend; do
              docker push "$ECR_REGISTRY/$repo:$RELEASE_TAG"
              docker push "$ECR_REGISTRY/$repo:$IMAGE_TAG"
            done
          '''
        }
      }
    }
  }
}
